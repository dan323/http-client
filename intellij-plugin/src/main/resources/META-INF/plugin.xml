<idea-plugin>
    <id>com.dan323.httpclient</id>
    <name>HTTP Client</name>
    <vendor>dan323</vendor>
    <description>Run requests from .http files (a practical subset of the JetBrains format) in any IntelliJ-based IDE.</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="HTTP Client File" language="HttpClientFile" extensions="http" implementationClass="com.dan323.httpclient.intellij.HttpFileType"
                  fieldName="INSTANCE"/>
        <lang.parserDefinition language="HttpClientFile"
                               implementationClass="com.dan323.httpclient.intellij.HttpParserDefinition"/>
        <lang.syntaxHighlighterFactory language="HttpClientFile"
                                       implementationClass="com.dan323.httpclient.intellij.HttpSyntaxHighlighterFactory"/>
        <externalAnnotator language="HttpClientFile" implementationClass="com.dan323.httpclient.intellij.HttpAnnotator"/>
        <completion.contributor language="HttpClientFile" implementationClass="com.dan323.httpclient.intellij.HttpCompletionContributor"/>
        <typedHandler implementation="com.dan323.httpclient.intellij.HttpTypedHandler"/>
        <gotoDeclarationHandler implementation="com.dan323.httpclient.intellij.HttpGotoDeclarationHandler"/>
        <runLineMarkerContributor language="HttpClientFile"
                                  implementationClass="com.dan323.httpclient.intellij.RunLineMarker"/>
        <editorNotificationProvider implementation="com.dan323.httpclient.intellij.EnvironmentEditorHeaderProvider"/>
        <toolWindow id="HTTP Response" anchor="bottom"
                    factoryClass="com.dan323.httpclient.intellij.ResponseToolWindowFactory"/>
        <applicationConfigurable parentId="tools" id="com.dan323.httpclient.allowlists"
                                 displayName="HTTP Client: Allowed Access"
                                 instance="com.dan323.httpclient.intellij.AllowlistConfigurable"/>
    </extensions>

    <actions>
        <action id="httpclient.RunRequest" class="com.dan323.httpclient.intellij.RunRequestAction"
                text="Run HTTP Request" description="Run the request at the caret">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt R"/>
        </action>
        <action id="httpclient.RunAllRequests" class="com.dan323.httpclient.intellij.RunAllRequestsAction"
                text="Run All HTTP Requests" description="Run every request of the file in order">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="httpclient.RunRequest"/>
        </action>
        <action id="httpclient.ShowLinkedResponse" class="com.dan323.httpclient.intellij.ShowLinkedResponseAction"
                text="Show Linked HTTP Response" description="Show the latest response recorded for the request's &lt;&gt; link, without sending it">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="httpclient.RunAllRequests"/>
        </action>
        <action id="httpclient.CancelRequest" class="com.dan323.httpclient.intellij.CancelRequestAction"
                text="Cancel HTTP Request" description="Stop the HTTP request that is running"
                icon="AllIcons.Actions.Suspend"/>
        <action id="httpclient.SelectEnvironment" class="com.dan323.httpclient.intellij.SelectEnvironmentAction"
                text="Select HTTP Environment" description="Choose the environment for HTTP requests">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="httpclient.RunRequest"/>
        </action>
    </actions>
</idea-plugin>
