# Response assertions. Run with: --env dev
# Syntax: # @assert <expression> <operator> [expected]
# @name ok
# @assert status == 200
# @assert headers.content-type contains json
# @assert body.$.args.user exists
# @assert body.$.url exists
# @assert body.$.nope !exists
# @assert body.$.url matches .*/get\?user=.*
GET {{base}}/get?user={{user}}

